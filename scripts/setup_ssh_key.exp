#!/usr/bin/expect -f
# 自动配置SSH密钥认证的Expect脚本

set timeout 30

# 配置参数
set server "47.97.113.144"
set port "222"
set user "root"
set password "zXc363324112"

# 密钥内容（从私钥导出的公钥）
set public_key "ssh-rsa  gong363324112@qq.com"

spawn ssh -p $port $user@$server

# 等待密码提示
expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
    }
}

# 等待shell提示符
expect "#"

# 配置SSH密钥认证
send "mkdir -p ~/.ssh\r"
expect "#"

send "chmod 700 ~/.ssh\r"
expect "#"

send "echo '$public_key' >> ~/.ssh/authorized_keys\r"
expect "#"

send "chmod 600 ~/.ssh/authorized_keys\r"
expect "#"

send "systemctl restart sshd\r"
expect "#"

# 测试配置
send "echo '=== 密钥配置完成 ===' && cat ~/.ssh/authorized_keys\r"
expect "#"

# 保持会话
interact
