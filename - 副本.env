# JARVIS 环境变量配置示例
# 复制此文件为 .env 并填入你的密钥
# 心跳配置
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=1
HEARTBEAT_LOG=false
HEARTBEAK_TIMEZONE=Asia/Shanghai
HEARTBEAK_GREETING=true
# DeepSeek 配置 (推荐)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Zhipu AI (BigModel) 配置
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://integrate.api.nvidia.com/v1
ZHIPU_MODEL=z-ai/glm4.7

# OpenAI 配置 (可选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=dall-e-3

# Ollama 配置 (本地运行)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Home Assistant 配置 (可选)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_ha_long_lived_access_token


# LongPort 股票数据配置
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=

# SMTP 邮件配置 (可选)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=JARVIS

# 网络搜索配置 (Tavily & Brave)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Local Gemini 配置
GEMINI_API_KEY=
GEMINI_BASE_URL=http://localhost:8045/v1
GEMINI_MODEL=gemini-pro-2.5

# 视觉理解专用模型配置 (独立于主 LLM)
VISION_ENABLED=true
VISION_PROVIDER=openai
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash
VISION_DETAIL=high
VISION_MAX_TOKENS=1024


# IM 适配器配置
QQ_ENABLED=true
QQ_ONEBOT_WS_HOST=127.0.0.1
QQ_ONEBOT_WS_PORT=8011
QQ_ALLOWED_GROUPS=
QQ_ADMIN_QQ=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
